{
  "name": "@digicroz/dev-kit",
  "version": "1.0.11",
  "description": "A comprehensive CLI toolkit for modern development workflows - featuring task automation, project cleaning, and developer utilities",
  "keywords": [
    "automation",
    "build-tools",
    "cli",
    "cli-tools",
    "dev-kit",
    "developer-tools",
    "development",
    "modern-dev",
    "project-management",
    "task-runner",
    "toolkit",
    "typescript",
    "workflow"
  ],
  "homepage": "https://github.com/digicroz/dev-kit#readme",
  "bugs": {
    "url": "https://github.com/digicroz/dev-kit/issues"
  },
  "license": "MIT",
  "author": {
    "name": "digicroz",
    "url": "https://github.com/digicroz"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/digicroz/dev-kit.git"
  },
  "bin": {
    "dk": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "bin"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "npx rimraf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "release:patch": "npm version patch",
    "postversion": "git push && git push --tags && npm publish",
    "deploy:dev": "dk deploy dev",
    "deploy:prod": "dk deploy prod",
    "link": "npm run build && npm link",
    "unlink": "npm unlink -g @digicroz/dev-kit",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --fix",
    "lint:check": "oxlint --max-warnings 216",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "npm run lint:check && npm run format:check && npm run typecheck",
    "fix": "npm run lint && npm run format"
  },
  "dependencies": {
    "@digicroz/js-kit": "^1.0.14",
    "@inquirer/search": "^3.0.16",
    "@types/inquirer": "^9.0.8",
    "boxen": "^8.0.1",
    "chalk": "^5.3.0",
    "cli-spinners": "^3.2.0",
    "commander": "^11.0.0",
    "fast-glob": "^3.3.3",
    "figlet": "^1.7.0",
    "gradient-string": "^3.0.0",
    "image-size": "^2.0.2",
    "inquirer": "^12.7.0",
    "minimist": "^1.2.8",
    "mongodb": "^6.10.0",
    "mysql2": "^3.11.3",
    "ora": "^8.2.0",
    "pg": "^8.12.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
    "@types/image-size": "^0.7.0",
    "@types/minimist": "^1.2.5",
    "@types/node": "^24.0.10",
    "@types/pg": "^8.11.10",
    "@types/sqlite3": "^3.1.11",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.4.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,md,yml,yaml}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
