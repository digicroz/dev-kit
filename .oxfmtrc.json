{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "tabWidth": 2,
  "printWidth": 100,
  "endOfLine": "lf",
  "arrowParens": "always",
  "sortPackageJson": {},
  "sortImports": {
    "newlinesBetween": true
  },
  "ignorePatterns": ["dist", "node_modules/**", "package-lock.json", "coverage"]
}
